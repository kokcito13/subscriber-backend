# Docker environment variables
# Copy this to .env.local or use docker-compose --env-file

MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=!ChangeMe!
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306

NGINX_PORT=8080

# Database URL for Symfony (will be set automatically in docker-compose)
# DATABASE_URL=mysql://app:!ChangeMe!@database:3306/app?serverVersion=8.0.32&charset=utf8mb4
