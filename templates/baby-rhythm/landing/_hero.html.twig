<section class="br-hero" aria-label="Introduction">
    <div class="container">
        <div class="row align-items-center g-5">

            {# ── Copy ──────────────────────────────────────────── #}
            <div class="col-lg-6 order-2 order-lg-1">
                <span class="br-hero-eyebrow">Smart Sleep Tracking · Ages 0–36 months</span>
                <h1>Your baby's rhythm,<br>understood.</h1>
                <p class="br-hero-sub">
                    Baby Rhythm learns your baby's natural sleep patterns and tells you exactly
                    when to put them down — before overtiredness sets in. Designed to be
                    usable at 3 AM, with one hand, half asleep.
                </p>
                <a href="{{ download_url }}" class="br-badge-appstore" aria-label="Download Baby Rhythm on the App Store">
                    <svg class="br-badge-apple-icon" viewBox="0 0 814 1000" aria-hidden="true">
                        <path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105-57.8-155.5-127.4C46 600.3 0 456.4 0 316.2c0-213 139-325.9 265.7-325.9 71.6 0 131.1 47.2 173.5 47.2 40.2 0 109.7-50.3 190.5-50.3zm-78.5-191.7c37.1-44 63.8-105.2 63.8-166.4 0-8.4-.6-16.8-2-24.5-60.5 2.3-132.4 40.5-175.9 91.3-34.1 37.7-65.4 98.9-65.4 161.2 0 9 1.4 18 2 20.6 3.6.6 8.9 1.3 14.3 1.3 54.8 0 121-36.3 163.2-83.5z"/>
                    </svg>
                    <span class="br-badge-text">
                        <span class="br-badge-text-small">Download on the</span>
                        <span class="br-badge-text-large">App Store</span>
                    </span>
                </a>
            </div>

            {# ── Phone mockup ──────────────────────────────────── #}
            <div class="col-lg-6 order-1 order-lg-2">
                <div class="br-phone-wrap">
                    <div class="br-phone" role="img" aria-label="Baby Rhythm app screen showing next nap prediction for baby Mia">
                        <div class="br-phone-notch" aria-hidden="true"></div>
                        <div class="br-phone-screen">

                            <div class="br-phone-top-row" aria-hidden="true">
                                <span class="br-phone-app-label">Baby Rhythm</span>
                                <span class="br-phone-time">9:41</span>
                            </div>

                            <p class="br-phone-baby-name" aria-hidden="true">Mia</p>
                            <p class="br-phone-baby-age" aria-hidden="true">4 months · awake for 1h 42m</p>

                            <div class="br-phone-card" aria-hidden="true">
                                <p class="br-phone-card-label">Next nap window</p>
                                <div class="br-phone-nap-row">
                                    <span class="br-phone-nap-number">23</span>
                                    <span class="br-phone-nap-unit">min</span>
                                </div>
                                <div class="br-phone-risk-row">
                                    <span class="br-phone-risk-indicator"></span>
                                    <span class="br-phone-risk-text">Low overtiredness risk</span>
                                </div>
                            </div>

                            <div class="br-phone-waves-card" aria-hidden="true">
                                <p class="br-phone-waves-label">Sleep sounds · Pink noise</p>
                                <div class="br-phone-waves">
                                    <div class="br-phone-wave-bar" style="height:8px"></div>
                                    <div class="br-phone-wave-bar" style="height:13px"></div>
                                    <div class="br-phone-wave-bar" style="height:18px"></div>
                                    <div class="br-phone-wave-bar" style="height:22px"></div>
                                    <div class="br-phone-wave-bar" style="height:17px"></div>
                                    <div class="br-phone-wave-bar" style="height:13px"></div>
                                    <div class="br-phone-wave-bar" style="height:8px"></div>
                                    <div class="br-phone-wave-bar" style="height:11px"></div>
                                    <div class="br-phone-wave-bar" style="height:19px"></div>
                                    <div class="br-phone-wave-bar" style="height:24px"></div>
                                    <div class="br-phone-wave-bar" style="height:16px"></div>
                                    <div class="br-phone-wave-bar" style="height:10px"></div>
                                    <div class="br-phone-wave-bar" style="height:7px"></div>
                                    <div class="br-phone-wave-bar" style="height:14px"></div>
                                    <div class="br-phone-wave-bar" style="height:20px"></div>
                                    <div class="br-phone-wave-bar" style="height:15px"></div>
                                </div>
                            </div>

                            <div class="br-phone-sleep-btn" aria-hidden="true">&#9654;&nbsp; Start Sleep</div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
