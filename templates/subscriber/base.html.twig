<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Track all your subscriptions in one place. Never forget a renewal again.{% endblock %}">

    {# Bootstrap 5 CSS #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {# Bootstrap Icons #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --bs-primary: #5C6BC0;
            --brand-primary: #5C6BC0;
            --brand-accent: #26C6DA;
            --brand-bg: #F8F9FF;
            --brand-dark: #1A1D2E;
            --brand-text-muted: #6B7280;
        }

        body {
            background-color: var(--brand-bg);
            color: var(--brand-dark);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.4rem;
            color: var(--brand-primary) !important;
            letter-spacing: -0.5px;
        }

        .nav-link {
            color: var(--brand-dark) !important;
            font-weight: 500;
            transition: color 0.2s;
        }

        .nav-link:hover {
            color: var(--brand-primary) !important;
        }

        .btn-brand {
            background-color: var(--brand-primary);
            border-color: var(--brand-primary);
            color: #fff;
            font-weight: 600;
            border-radius: 10px;
            padding: 0.5rem 1.25rem;
            transition: background-color 0.2s, transform 0.1s;
        }

        .btn-brand:hover {
            background-color: #4a58b0;
            border-color: #4a58b0;
            color: #fff;
            transform: translateY(-1px);
        }

        footer {
            background-color: var(--brand-dark);
            color: rgba(255,255,255,0.7);
        }

        footer a {
            color: rgba(255,255,255,0.6);
            text-decoration: none;
            transition: color 0.2s;
        }

        footer a:hover {
            color: #fff;
        }

        .store-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: #111;
            color: #fff;
            border-radius: 10px;
            padding: 0.4rem 1rem;
            font-size: 0.85rem;
            font-weight: 500;
            text-decoration: none;
            border: 1px solid rgba(255,255,255,0.15);
            transition: background 0.2s;
        }

        .store-badge:hover {
            background: #333;
            color: #fff;
        }

        .store-badge i {
            font-size: 1.4rem;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body>

{# ── Navbar ──────────────────────────────────────────────────────────────── #}
<nav class="navbar navbar-expand-lg bg-white shadow-sm sticky-top">
    <div class="container">
        <a class="navbar-brand" href="{{ path('subscriber_home') }}">
            <i class="bi bi-bookmark-check-fill me-1"></i>{{ app_name }}
        </a>
        <button class="navbar-toggler border-0" type="button"
                data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav mx-auto gap-1">
                <li class="nav-item"><a class="nav-link px-3" href="#">Home</a></li>
                <li class="nav-item"><a class="nav-link px-3" href="#features">Features</a></li>
                <li class="nav-item"><a class="nav-link px-3" href="#how-it-works">How It Works</a></li>
                <li class="nav-item"><a class="nav-link px-3" href="#contact">Contact</a></li>
            </ul>
            <a href="#download" class="btn btn-brand ms-lg-3">
                <i class="bi bi-arrow-down-circle me-1"></i> Download
            </a>
        </div>
    </div>
</nav>

{# ── Page Content ─────────────────────────────────────────────────────────── #}
{% block body %}
    {% block content %}{% endblock %}
{% endblock %}

{# ── Footer ───────────────────────────────────────────────────────────────── #}
<footer id="contact" class="py-5 mt-5">
    <div class="container">
        <div class="row align-items-center gy-4">

            <div class="col-lg-4 text-center text-lg-start">
                <span class="fs-5 fw-bold text-white">
                    <i class="bi bi-bookmark-check-fill me-1" style="color: var(--brand-accent)"></i>
                    {{ app_name }}
                </span>
                <p class="mt-2 mb-0" style="font-size: 0.85rem;">
                    Track subscriptions. Save money.
                </p>
            </div>

            <div class="col-lg-4 text-center">
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    {# TODO: replace placeholder hrefs with real App Store / Play Store URLs #}
                    <a href="#" class="store-badge">
                        <i class="bi bi-apple"></i>
                        <span><small class="d-block" style="font-size:0.65rem;opacity:.7">Download on the</small>App Store</span>
                    </a>
                    <a href="#" class="store-badge">
                        <i class="bi bi-google-play"></i>
                        <span><small class="d-block" style="font-size:0.65rem;opacity:.7">Get it on</small>Google Play</span>
                    </a>
                </div>
            </div>

            <div class="col-lg-4 text-center text-lg-end">
                <div class="d-flex justify-content-center justify-content-lg-end gap-3 mb-3">
                    {# TODO: replace placeholder hrefs with real social URLs #}
                    <a href="#"><i class="bi bi-twitter-x fs-5"></i></a>
                    <a href="#"><i class="bi bi-instagram fs-5"></i></a>
                    <a href="#"><i class="bi bi-facebook fs-5"></i></a>
                </div>
                <p class="mb-0" style="font-size: 0.8rem;">
                    &copy; {{ "now"|date("Y") }} {{ app_name }}. All rights reserved.
                </p>
            </div>

        </div>
    </div>
</footer>

{# Bootstrap 5 JS Bundle #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{% block scripts %}{% endblock %}
</body>
</html>
