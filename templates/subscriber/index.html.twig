{% extends 'subscriber/base.html.twig' %}

{% block title %}{{ app_name }} — Track Every Subscription{% endblock %}
{% block meta_description %}Stop wasting money on forgotten subscriptions. {{ app_name }} gives you a clear view of all your recurring expenses in one place.{% endblock %}

{% block stylesheets %}
<style>
    /* ── Hero ─────────────────────────────────────────────────── */
    .hero {
        background: linear-gradient(135deg, #eef0ff 0%, #e8f8fb 100%);
        padding: 6rem 0 4rem;
        overflow: hidden;
    }

    .hero h1 {
        font-size: clamp(2rem, 5vw, 3.25rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -1px;
        color: var(--brand-dark);
    }

    .hero h1 span {
        color: var(--brand-primary);
    }

    .hero .lead {
        font-size: 1.15rem;
        color: var(--brand-text-muted);
        max-width: 480px;
    }

    .hero-mockup {
        background: linear-gradient(145deg, #dde1ff, #c8eef4);
        border-radius: 2rem;
        aspect-ratio: 9/16;
        max-width: 260px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 30px 60px rgba(92, 107, 192, 0.2);
        margin: 0 auto;
    }

    /* ── Features ─────────────────────────────────────────────── */
    .features { padding: 5rem 0; }

    .feature-card {
        border: none;
        border-radius: 1.25rem;
        padding: 2rem;
        background: #fff;
        box-shadow: 0 4px 24px rgba(92, 107, 192, 0.07);
        height: 100%;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .feature-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 32px rgba(92, 107, 192, 0.13);
    }

    .feature-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    /* ── How It Works ─────────────────────────────────────────── */
    .how-it-works { background: #fff; padding: 5rem 0; }

    .step-number {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--brand-primary);
        color: #fff;
        font-weight: 700;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 4px 14px rgba(92, 107, 192, 0.35);
    }

    .step-connector {
        flex: 1;
        height: 2px;
        background: linear-gradient(90deg, var(--brand-primary), var(--brand-accent));
        opacity: 0.3;
        margin: 0 1rem;
        align-self: center;
    }

    /* ── Final CTA ────────────────────────────────────────────── */
    .final-cta {
        background: linear-gradient(135deg, var(--brand-primary), #7986CB);
        padding: 5rem 0;
        color: #fff;
    }

    .final-cta h2 {
        font-size: clamp(1.6rem, 3.5vw, 2.5rem);
        font-weight: 800;
    }

    .btn-store {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        background: #fff;
        color: var(--brand-dark);
        border-radius: 12px;
        padding: 0.65rem 1.4rem;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }

    .btn-store:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(0,0,0,0.2);
        color: var(--brand-dark);
    }

    .btn-store i { font-size: 1.5rem; }
    .btn-store small { font-size: 0.65rem; font-weight: 400; opacity: 0.6; display: block; }
</style>
{% endblock %}

{% block content %}

{# ══════════════════════════════════════════════════════════════
   1. HERO
══════════════════════════════════════════════════════════════ #}
<section class="hero">
    <div class="container">
        <div class="row align-items-center gy-5">

            <div class="col-lg-6">
                <span class="badge mb-3 px-3 py-2"
                      style="background:rgba(92,107,192,0.12);color:var(--brand-primary);font-size:.8rem;border-radius:50px">
                    <i class="bi bi-stars me-1"></i> Free to Download
                </span>
                <h1>
                    Take control of your<br>
                    <span>subscriptions</span><br>
                    — and your money.
                </h1>
                <p class="lead mt-3 mb-4">
                    {{ app_name }} keeps all your recurring expenses in one place.
                    Track spending, get renewal reminders, and cancel what you don't need.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    {# TODO: replace placeholder hrefs with real App Store / Play Store URLs #}
                    <a href="#" class="btn-store">
                        <i class="bi bi-apple"></i>
                        <span>
                            <small>Download on the</small>
                            App Store
                        </span>
                    </a>
                    <a href="#" class="btn-store">
                        <i class="bi bi-google-play"></i>
                        <span>
                            <small>Get it on</small>
                            Google Play
                        </span>
                    </a>
                </div>
            </div>

            <div class="col-lg-6 d-flex justify-content-center">
                <div class="hero-mockup">
                    {# TODO: replace placeholder with real app screenshot #}
                    <div class="text-center text-muted p-4">
                        <i class="bi bi-phone" style="font-size:4rem;opacity:.3"></i>
                        <p class="mt-2" style="font-size:.75rem;opacity:.4">App screenshot</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>


{# ══════════════════════════════════════════════════════════════
   2. FEATURES
══════════════════════════════════════════════════════════════ #}
<section id="features" class="features">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-800" style="font-weight:800">Everything you need</h2>
            <p class="text-muted mt-2" style="max-width:500px;margin:0 auto">
                Simple tools to understand and control your recurring expenses.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background:rgba(92,107,192,0.1);color:var(--brand-primary)">
                        <i class="bi bi-grid-1x2"></i>
                    </div>
                    <h5 class="fw-700 mb-2" style="font-weight:700">All subscriptions in one view</h5>
                    <p class="text-muted mb-0" style="font-size:.9rem">
                        Add every service you pay for — streaming, SaaS, fitness apps — and see them all on a single dashboard.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background:rgba(38,198,218,0.1);color:#00ACC1">
                        <i class="bi bi-bell-fill"></i>
                    </div>
                    <h5 class="fw-700 mb-2" style="font-weight:700">Renewal reminders</h5>
                    <p class="text-muted mb-0" style="font-size:.9rem">
                        Get notified before each billing date so you're never surprised by a charge you forgot about.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon" style="background:rgba(102,187,106,0.1);color:#43A047">
                        <i class="bi bi-bar-chart-line-fill"></i>
                    </div>
                    <h5 class="fw-700 mb-2" style="font-weight:700">Spending insights</h5>
                    <p class="text-muted mb-0" style="font-size:.9rem">
                        See your total monthly and yearly spend at a glance. Identify subscriptions you no longer use.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>


{# ══════════════════════════════════════════════════════════════
   3. HOW IT WORKS
══════════════════════════════════════════════════════════════ #}
<section id="how-it-works" class="how-it-works">
    <div class="container">

        <div class="text-center mb-5">
            <h2 style="font-weight:800">How it works</h2>
            <p class="text-muted mt-2">Up and running in under a minute.</p>
        </div>

        {# Desktop: horizontal connector #}
        <div class="d-none d-md-flex align-items-start mb-4">
            <div class="text-center flex-fill">
                <div class="step-number mx-auto mb-3">1</div>
                <h6 class="fw-bold">Download the app</h6>
                <p class="text-muted small px-3">
                    Available free on the App Store and Google Play.
                    {# TODO: replace placeholder #}
                </p>
            </div>
            <div class="step-connector mt-3"></div>
            <div class="text-center flex-fill">
                <div class="step-number mx-auto mb-3">2</div>
                <h6 class="fw-bold">Add your subscriptions</h6>
                <p class="text-muted small px-3">
                    Enter the name, price, billing period, and next renewal date for each service.
                </p>
            </div>
            <div class="step-connector mt-3"></div>
            <div class="text-center flex-fill">
                <div class="step-number mx-auto mb-3">3</div>
                <h6 class="fw-bold">Stay in control</h6>
                <p class="text-muted small px-3">
                    Review your total spend, get reminders, and cancel anything you don't need.
                </p>
            </div>
        </div>

        {# Mobile: vertical list #}
        <div class="d-md-none d-flex flex-column gap-4">
            {% for step in [
                {num: '1', title: 'Download the app',         desc: 'Available free on the App Store and Google Play.'},
                {num: '2', title: 'Add your subscriptions',   desc: 'Enter the name, price, billing period, and renewal date.'},
                {num: '3', title: 'Stay in control',          desc: 'Review spend, get reminders, cancel what you don\'t need.'},
            ] %}
            <div class="d-flex align-items-start gap-3">
                <div class="step-number flex-shrink-0">{{ step.num }}</div>
                <div>
                    <h6 class="fw-bold mb-1">{{ step.title }}</h6>
                    <p class="text-muted small mb-0">{{ step.desc }}</p>
                </div>
            </div>
            {% endfor %}
        </div>

    </div>
</section>


{# ══════════════════════════════════════════════════════════════
   4. TESTIMONIALS (optional — uncomment when you have real reviews)
══════════════════════════════════════════════════════════════ #}
{#
<section class="py-5" style="background:var(--brand-bg)">
    <div class="container">
        <h2 class="text-center fw-800 mb-5" style="font-weight:800">What users say</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="mb-2 text-warning">
                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <p class="text-muted small">"TODO: real review text"</p>
                    <p class="fw-bold mb-0 small">— TODO: User Name</p>
                </div>
            </div>
        </div>
    </div>
</section>
