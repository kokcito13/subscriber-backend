{# ══════════════════════════════════════════════════════════════
   5. FINAL CTA
══════════════════════════════════════════════════════════════ #}
<section id="download" class="final-cta text-center">
    <div class="container">
        <h2>Ready to stop overpaying?</h2>
        <p class="mt-3 mb-5" style="opacity:.85;font-size:1.1rem;max-width:480px;margin-left:auto;margin-right:auto">
            Join thousands of users who use {{ app_name }} to track their subscriptions and save money every month.
        </p>
        <div class="d-flex justify-content-center flex-wrap gap-3">
            {# TODO: replace placeholder hrefs with real App Store / Play Store URLs #}
            <a href="#" class="btn-store">
                <i class="bi bi-apple"></i>
                <span>
                    <small>Download on the</small>
                    App Store
                </span>
            </a>
            <a href="#" class="btn-store">
                <i class="bi bi-google-play"></i>
                <span>
                    <small>Get it on</small>
                    Google Play
                </span>
            </a>
        </div>
    </div>
</section>

{% endblock %}
